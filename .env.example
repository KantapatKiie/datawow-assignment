# ---------- Database ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=concert
POSTGRES_PORT=5432

# ---------- API (NestJS) ----------
API_PORT=4000
# When running the API on the host (npm run dev), point at localhost.
# docker compose overrides this with the `postgres` service host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/concert?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

# ---------- Seed accounts ----------
SEED_ADMIN_EMAIL=admin@datawow.io
SEED_ADMIN_PASSWORD=Admin@1234
SEED_USER_EMAIL=user@datawow.io
SEED_USER_PASSWORD=User@1234

# ---------- Web (Next.js) ----------
WEB_PORT=3000
API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_COOKIE_SECURE=false
