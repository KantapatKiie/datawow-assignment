{
  "name": "datawow-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "Free Concert Ticket booking system \u2014 Next.js (web) + NestJS (api) monorepo",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=api && npm run build --workspace=web",
    "test": "npm run test --workspace=api",
    "test:api": "npm run test --workspace=api",
    "test:web": "npm run test --workspace=web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run prisma:migrate --workspace=api",
    "db:seed": "npm run prisma:seed --workspace=api",
    "db:studio": "npm run prisma:studio --workspace=api",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api web",
    "k6:smoke": "npm run k6:smoke --workspace=api",
    "k6:race": "npm run k6:race --workspace=api",
    "k6:load": "npm run k6:load --workspace=api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2"
  }
}
